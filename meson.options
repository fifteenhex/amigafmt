option('cpu', type: 'string', value: '68040',
       description: 'CPU to compile for (-m<cpu>): 68040 or 68060')
option('fd_dir', type: 'string', value: '',
       description: 'directory of AmigaOS .fd files for the fdtab target (amitools\' data/fd)')
option('ndk_fd_dir', type: 'string', value: '',
       description: 'NDK fd directory; when set, the fdcheck test compares every vector table with it')
